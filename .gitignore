# ========================================
# RussianIptvAggregator .gitignore
# ========================================

# --- Результаты сборки .NET ---
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]uild/
[Ll]og/
[Ll]ogs/

# --- Visual Studio ---
.vs/
*.sln.docstates
*.sln.back
*.csproj.back
*.vbproj.back
*.fsproj.back

# --- Visual Studio Code ---
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# --- Rider / ReSharper ---
.idea/
*.sln.iml
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# --- NuGet ---
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nupkg
*.snupkg
project.lock.json
project.fragment.lock.json
artifacts/

# --- Пользовательские файлы (не коммитим) ---
*.user
*.suo
*.userprefs
*.ntvs_sln.docstates
*.rsuser
*.DotSettings

# --- Тесты ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
*.coverage
*.coveragexml
*.runsettings

# --- Crash dumps ---
*.dmp
*.mdmp
*.hdmp

# --- Выходные файлы нашего проекта ---
output/*.m3u
output/*.log
output/*.db
output/*.db-shm
output/*.db-wal
output/*.json
!output/.gitkeep

# --- Конфиги, которые могут содержать секреты ---
**/appsettings.*.json
!appsettings.json
!appsettings.Development.json
secrets.json
*.pfx
*.key

# --- OS-специфичные файлы ---
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# macOS
.DS_Store
.AppleDouble
._*
.Spotlight-V100
.Trashes

# Linux
*~
.directory

# --- Прочее ---
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.RptTempFile
*.Cache
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# Node (если вдруг понадобится для MCP)
node_modules/
npm-debug.log
yarn-error.log

# Docker
.dockerignore

# Publish output
*.Publish.xml
*.pubxml