{
  "Input": {
    "PlaylistsFile": "config/playlists.json"
  },
  "Filtering": {
    "RussianLanguageCodes": ["rus", "ru"]
  },
  "HealthCheck": {
    "Enabled": true,
    "MaxDegreeOfParallelism": 5,
    "SegmentsToCheck": 3,
    "ManifestTimeoutSeconds": 5,
    "SegmentTimeoutSeconds": 3
  },
  "Output": {
    "PlaylistFile": "output/russian-iptv.m3u",
    "SortByGroup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  }
}
